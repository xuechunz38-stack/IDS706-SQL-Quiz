# Copy to .env (never commit .env). Use the Supabase *Session pooler* strings.
# Owner connection: used by scripts/seed.py and scripts/check_db.py (and the GitHub Secret)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Passwords seed.py assigns to the two runtime roles
TAKER_PASSWORD=<choose-a-long-random-password>
APP_PASSWORD=<choose-another-long-random-password>

# Used by the Streamlit app
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>
APP_DATABASE_URL=postgresql://quiz_app.<project-ref>:<APP_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
TAKER_DATABASE_URL=postgresql://quiz_taker.<project-ref>:<TAKER_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
